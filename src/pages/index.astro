---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';

// We'll mock some products for now since DB might not have them yet
const featuredProducts = [
    {
        id: '1',
        title: 'Neural Bracer X-1',
        description: 'Advanced digital accessory for the metaverse. Syncs with your digital identity.',
        price: 49.99,
        image: '/hero.png',
        slug: 'neural-bracer-x1'
    },
    {
        id: '2',
        title: 'Synth-Fiber Cloak',
        description: 'Ultra-lightweight digital apparel with dynamic texture mapping.',
        price: 89.99,
        image: 'https://images.unsplash.com/photo-1614728263952-84ea256f9679?auto=format&fit=crop&q=80&w=800',
        slug: 'synth-fiber-cloak'
    }
];
---

<Layout title="DigitalStore | Premium Virtual Apparel">
    <section class="relative pt-32 pb-20 overflow-hidden">
        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-3xl">
                <h1 class="text-6xl md:text-8xl font-['Outfit'] font-extrabold leading-tight mb-6">
                    Elevate Your <span class="bg-linear-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">Digital Persona</span>
                </h1>
                <p class="text-xl text-white/60 mb-10 max-w-xl leading-relaxed">
                    Exclusive digital accessories and apparel designed for the next generation of virtual identity. 
                    Premium, limited edition, and fully tradable.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/products" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-full transition-all transform hover:scale-105">
                        Shop Collection
                    </a>
                    <a href="#featured" class="px-8 py-4 glass text-white font-bold rounded-full hover:bg-white/10 transition-all">
                        View Featured
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute top-1/2 -right-20 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/20 blur-[120px] rounded-full"></div>
    </section>

    <section id="featured" class="py-24 bg-white/[0.02]">
        <div class="container mx-auto px-6">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-4xl font-['Outfit'] font-bold mb-4">Featured Releases</h2>
                    <p class="text-white/40">Handpicked digital products for your collection.</p>
                </div>
                <a href="/products" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">See all products &rarr;</a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {featuredProducts.map((product) => (
                    <ProductCard client:load product={product} />
                ))}
            </div>
        </div>
    </section>
</Layout>
