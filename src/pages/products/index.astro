---
import Layout from '../../layouts/Layout.astro';
import { ProductCard } from '../../components/ProductCard';
import { supabase } from '../../lib/supabase';

// URL-driven filters
const categoryId = Astro.url.searchParams.get('category');
const searchQuery = Astro.url.searchParams.get('q');

let query = supabase.from('products').select('*').eq('is_active', true);

if (categoryId) {
    query = query.eq('category_id', categoryId);
}

if (searchQuery) {
    query = query.ilike('title', `%${searchQuery}%`);
}

const { data: products, error } = await query;
const { data: categories } = await supabase.from('categories').select('*');

if (error) console.log('Error fetching products:', error);

const displayProducts = (products && products.length > 0) ? products : [];
---

<Layout title="Catálogo de Productos | DigitalStore">
    <div class="container mx-auto px-6 py-12">
        <header class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
            <div class="max-w-xl">
                <h1 class="text-4xl md:text-5xl font-['Outfit'] font-bold text-brand-gray mb-4">Catálogo Completo</h1>
                <p class="text-[#86868B]">
                    Encuentra calidad premium en cada detalle. Desde ropa exclusiva hasta periféricos de alto rendimiento.
                </p>
            </div>
            
            <!-- Search Bar -->
            <form action="/products" method="GET" class="w-full md:w-auto relative group">
                <input 
                    type="text" 
                    name="q" 
                    value={searchQuery || ''}
                    placeholder="Buscar producto..." 
                    class="w-full md:w-80 px-6 py-3 bg-surface-gray rounded-full focus:outline-none focus:ring-2 focus:ring-brand-blue/20 transition-all font-medium text-sm"
                />
                <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-blue transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>
                {categoryId && <input type="hidden" name="category" value={categoryId} />}
            </form>
        </header>

        <!-- Dynamic Category Filter -->
        <div class="flex overflow-x-auto pb-8 gap-3 no-scrollbar border-b border-black/5 mb-12">
            <a 
                href="/products" 
                class={`px-6 py-2 rounded-full text-sm font-semibold transition-all ${!categoryId ? 'bg-brand-gray text-white' : 'bg-surface-gray text-brand-gray hover:bg-gray-200'}`}
            >
                Todo
            </a>
            {categories?.map((cat) => (
                <a 
                    href={`/products?category=${cat.id}${searchQuery ? `&q=${searchQuery}` : ''}`}
                    class={`px-6 py-2 rounded-full text-sm font-semibold transition-all ${categoryId === cat.id ? 'bg-brand-gray text-white' : 'bg-surface-gray text-brand-gray hover:bg-gray-200'}`}
                >
                    {cat.name}
                </a>
            ))}
        </div>

        {displayProducts.length > 0 ? (
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
                {displayProducts.map((product) => (
                    <ProductCard client:load product={product} />
                ))}
            </section>
        ) : (
            <div class="py-24 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-surface-gray rounded-full mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#86868B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <h3 class="text-xl font-bold mb-2">No encontramos resultados</h3>
                <p class="text-[#86868B]">Prueba con otros términos o cambia de categoría.</p>
                <a href="/products" class="inline-block mt-8 text-brand-blue font-bold">Limpiar filtros</a>
            </div>
        )}
    </div>
</Layout>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
