---
interface Props {
	title: string;
    description?: string;
}

const { title, description = "Premium Digital E-commerce" } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#050505] text-white font-['Inter'] selection:bg-purple-500/30">
		<div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(120,0,255,0.15),transparent_50%)] pointer-events-none"></div>
        <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#050505]/60 backdrop-blur-md">
            <nav class="container mx-auto px-6 h-16 flex items-center justify-between">
                <a href="/" class="text-2xl font-['Outfit'] font-bold bg-linear-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">
                    DigitalStore
                </a>
                <div class="flex items-center gap-8">
                    <a href="/products" class="text-sm font-medium text-white/70 hover:text-white transition-colors">Products</a>
                    <a href="/cart" class="relative p-2 text-white/70 hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        <span class="absolute top-0 right-0 w-4 h-4 bg-purple-600 text-[10px] flex items-center justify-center rounded-full border border-black">0</span>
                    </a>
                </div>
            </nav>
        </header>
        <main class="relative">
            <slot />
        </main>
        <footer class="border-t border-white/5 py-12 bg-[#020202]">
            <div class="container mx-auto px-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-8">
                    <div class="text-white/40 text-sm">
                        &copy; 2026 DigitalStore. All rights reserved.
                    </div>
                    <div class="flex gap-6">
                        <a href="#" class="text-white/40 hover:text-white transition-colors">Twitter</a>
                        <a href="#" class="text-white/40 hover:text-white transition-colors">Discord</a>
                        <a href="#" class="text-white/40 hover:text-white transition-colors">Terms</a>
                    </div>
                </div>
            </div>
        </footer>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html {
		scrollbar-gutter: stable;
	}
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
