---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Premium Digital E-commerce" } = Astro.props;
import "../styles/global.css";
import AuthHeaderButton from "@/components/auth/AuthHeaderButton";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-brand-gray font-['Inter']">
    <!-- Desktop Header -->
    <header
      class="hidden md:block sticky top-0 z-50 w-full border-b border-black/5 bg-white/80 backdrop-blur-md"
    >
      <nav
        class="container mx-auto px-6 h-16 flex items-center justify-between"
      >
        <a href="/" class="text-xl font-['Outfit'] font-bold tracking-tight">
          DigitalStore<span class="text-brand-blue">.</span>
        </a>
        <div class="flex items-center gap-6">
          <a
            href="/products"
            class="text-sm font-medium hover:text-brand-blue transition-colors"
            >Productos</a
          >
          <div class="h-6 w-px bg-black/5"></div>
          <AuthHeaderButton client:load initialUser={Astro.locals.user} />
          <a
            href="/cart"
            class="relative p-2 hover:text-brand-blue transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="8" cy="21" r="1"></circle><circle
                cx="19"
                cy="21"
                r="1"></circle><path
                d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
              ></path></svg
            >
            <span
              class="absolute -top-1 -right-1 w-4 h-4 bg-brand-blue text-[10px] text-white flex items-center justify-center rounded-full"
              >0</span
            >
          </a>
        </div>
      </nav>
    </header>



    <!-- Main Content -->
    <main class="relative min-h-screen pb-24 md:pb-0">
      <slot />
    </main>

    <!-- Mobile Bottom Tab Bar -->
    <div
      class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-t border-black/5 safe-bottom"
    >
      <nav class="flex justify-around items-center h-16 px-4">
        <a
          href="/"
          class="flex flex-col items-center gap-1 text-[#8E8E93] hover:text-brand-blue transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
            ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
          >
          <span class="text-[10px] font-semibold">Inicio</span>
        </a>
        <a
          href="/products"
          class="flex flex-col items-center gap-1 text-[#8E8E93] hover:text-brand-blue transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect
              width="7"
              height="7"
              x="14"
              y="3"
              rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"
            ></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg
          >
          <span class="text-[10px] font-semibold">Catálogo</span>
        </a>
        <a
          href="/cart"
          class="flex flex-col items-center gap-1 text-[#8E8E93] hover:text-brand-blue transition-colors"
        >
          <div class="relative">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="8" cy="21" r="1"></circle><circle
                cx="19"
                cy="21"
                r="1"></circle><path
                d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
              ></path></svg
            >
            <span
              class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-brand-blue text-[9px] text-white flex items-center justify-center rounded-full"
              >0</span
            >
          </div>
          <span class="text-[10px] font-semibold">Carrito</span>
        </a>
        <a
          href="/profile"
          class="flex flex-col items-center gap-1 text-[#8E8E93] hover:text-brand-blue transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle
              cx="12"
              cy="7"
              r="4"></circle></svg
          >
          <span class="text-[10px] font-semibold">Perfil</span>
        </a>
      </nav>
    </div>

    <!-- Footer (Desktop only) -->
    <footer
      class="hidden md:block border-t border-black/5 py-12 bg-surface-gray"
    >
      <div class="container mx-auto px-6">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-8"
        >
          <div class="text-[#86868B] text-sm">
            &copy; 2026 DigitalStore. Todos los derechos reservados.
          </div>
          <div class="flex gap-6">
            <a
              href="#"
              class="text-[#86868B] hover:text-brand-gray transition-colors"
              >Twitter</a
            >
            <a
              href="#"
              class="text-[#86868B] hover:text-brand-gray transition-colors"
              >Discord</a
            >
            <a
              href="#"
              class="text-[#86868B] hover:text-brand-gray transition-colors"
              >Privacidad</a
            >
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-height: 100vh;
    -webkit-tap-highlight-color: transparent;
  }
</style>
